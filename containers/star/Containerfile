# syntax=docker/dockerfile:1
# Contenedor del Star (LLM Provider) FHS P2P — DEC-0088
# Ciclo P2P completo: bootstrap → DHT beacon → GossipSub → offer/bid/assign → stream.
# Puerto 4002: WebSocket libp2p (misiones chat directas).
#
# @rafex/galaxia-fhs-protocol se instala desde GitHub Packages.
# Pasar el token como secret de BuildKit:
#   podman build --secret id=gh_token,env=GH_TOKEN -f containers/star/Containerfile .

FROM docker.io/library/node:22-alpine AS builder
WORKDIR /app

COPY package*.json .npmrc ./
COPY examples/fhs-wire/package.json ./examples/fhs-wire/
COPY examples/star-example/package.json ./examples/star-example/

RUN npm install --ignore-scripts

COPY examples/star-example ./examples/star-example
COPY examples/fhs-wire ./examples/fhs-wire

RUN npm run build -w examples/fhs-wire && npm run build -w examples/star-example

FROM docker.io/library/node:22-alpine
WORKDIR /app
ENV NODE_ENV=production

RUN apk add --no-cache curl

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/examples/star-example/package.json ./examples/star-example/
COPY --from=builder /app/examples/star-example/dist ./examples/star-example/dist
COPY --from=builder /app/examples/fhs-wire/package.json ./examples/fhs-wire/
COPY --from=builder /app/examples/fhs-wire/dist ./examples/fhs-wire/dist

WORKDIR /app/examples/star-example
EXPOSE 4002

ENV FHS_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4002/tls/ws
ENV TLS_CERT_PATH=/certs/e2e.crt
ENV TLS_KEY_PATH=/certs/e2e.key
ENV FHS_BOOTSTRAP_ADDRS=
ENV LLAMA_CPP_URL=http://host.containers.internal:43110/v1
ENV PROVIDER_NAME="Star FHS"

CMD ["node", "dist/index.js"]
