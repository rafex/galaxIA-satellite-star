# syntax=docker/dockerfile:1
# Contenedor del OCR Provider FHS
# Ejecuta Tesseract dentro del contenedor y expone la tool por FHS/libp2p.
# Expone el nodo P2P en puerto 4003.
#
# @rafex/galaxia-fhs-protocol se instala desde GitHub Packages (requiere
# autenticación incluso para paquetes públicos). El token se pasa como
# secret de BuildKit (nunca queda en una capa de la imagen ni en el
# historial): construir con
#   DOCKER_BUILDKIT=1 docker build --secret id=gh_token,env=GH_TOKEN -f containers/satellite-ocr/Containerfile .
# o con podman (>=4):
#   podman build --secret id=gh_token,env=GH_TOKEN -f containers/satellite-ocr/Containerfile .

FROM docker.io/library/node:24-bookworm-slim AS builder
WORKDIR /app

COPY package*.json .npmrc ./
COPY examples/fhs-wire/package.json ./examples/fhs-wire/
COPY examples/satellite-ocr-example/package.json ./examples/satellite-ocr-example/

RUN npm install --ignore-scripts

COPY examples/satellite-ocr-example ./examples/satellite-ocr-example
COPY examples/fhs-wire ./examples/fhs-wire

RUN npm run build -w examples/fhs-wire && npm run build -w examples/satellite-ocr-example

# The full Bookworm image includes Debian's CA store.  The slim image does
# not, which makes the HTTPS Debian mirrors unusable before ca-certificates
# can be installed and leaves the OCR toolchain absent from the image.
FROM docker.io/library/node:24-bookworm
WORKDIR /app
ENV NODE_ENV=production
# Errores internos de libp2p (TLS rechazado, upgrades fallidos, dials
# fallidos) — sin esto se pierden en silencio. Solo nivel error; para depurar
# a fondo: -e DEBUG='libp2p:*' (muy verboso). Apagar: -e DEBUG=
ENV DEBUG=libp2p:*:error

# HTTPS avoids stalled HTTP mirror connections on isolated ARM hosts.
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends poppler-utils tesseract-ocr tesseract-ocr-eng tesseract-ocr-spa \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/examples/satellite-ocr-example/package.json ./examples/satellite-ocr-example/
COPY --from=builder /app/examples/satellite-ocr-example/dist ./examples/satellite-ocr-example/dist
COPY --from=builder /app/examples/fhs-wire/package.json ./examples/fhs-wire/
COPY --from=builder /app/examples/fhs-wire/dist ./examples/fhs-wire/dist

WORKDIR /app/examples/satellite-ocr-example
EXPOSE 4003

ENV FHS_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4003/tls/ws
ENV TLS_CERT_PATH=/certs/e2e.crt
ENV TLS_KEY_PATH=/certs/e2e.key
ENV NODE_EXTRA_CA_CERTS=/certs/e2e.crt
ENV FHS_BOOTSTRAP_ADDRS=
ENV FHS_ANNOUNCE_ADDRS=
ENV PROVIDER_NAME="Satellite OCR FHS"

CMD ["node", "dist/index.js"]
